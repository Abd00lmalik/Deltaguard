# DeltaGuard AI - Environment Variables
# Wave 1: App runs entirely on mock data. No env vars required to run.

# App
NEXT_PUBLIC_APP_NAME=DeltaGuard AI
NEXT_PUBLIC_DEMO_MODE=true

# SoSoValue API (Wave 2 integration - not required for Wave 1 demo)
SOSOVALUE_API_KEY=replace_with_real_key_in_wave2
SOSOVALUE_BASE_URL=replace_with_real_base_url_in_wave2

# SoDEX Execution API (Wave 2 integration - not required for Wave 1 demo)
SODEX_API_KEY=replace_with_real_key_in_wave2
SODEX_BASE_URL=replace_with_real_base_url_in_wave2

# SSI Protocol (Wave 2 integration - not required for Wave 1 demo)
SSI_API_BASE_URL=replace_with_real_base_url_in_wave2

# ValueChain RPC (Wave 3 integration - not required for Wave 1 demo)
VALUECHAIN_RPC_URL=replace_with_real_rpc_in_wave3

# Optional LLM upgrade for reasoning engine (replaces deterministic engine)
# If not set, deterministic TypeScript engine is used - this is the default for Wave 1
OPENAI_API_KEY=optional_for_llm_powered_reasoning
