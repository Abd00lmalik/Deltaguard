# DeltaGuard AI - Environment Variables
# Wave 1: App runs entirely on mock data in Demo Sandbox. No env vars required.
# Wave 2: Live Testnet Terminal mode requires the integrations below.

# App Mode (set to false to force terminal mode checks)
NEXT_PUBLIC_DEMO_MODE=true

# SoSoValue API (Market signals & ETF flows intelligence layer)
SOSOVALUE_API_KEY=your_sosovalue_api_key_here
SOSOVALUE_BASE_URL=https://api.sosovalue.xyz

# SSI Protocol (Index-style portfolio & delta holdings exposure layer)
SSI_API_BASE_URL=https://api.ssi-protocol.io

# SoDEX Execution API (High-performance testnet orderbook routing layer)
# Public Reads
SODEX_BASE_URL=https://api.sodex-testnet.com/v1/perpetuals
SODEX_SPOT_BASE_URL=https://api.sodex-testnet.com/v1/spot

# Signed Trade Submissions (requires account credentials and API keys)
SODEX_API_KEY=your_sodex_api_key_here
SODEX_API_PRIVATE_KEY=your_sodex_api_private_key_here

# Database State Layer (Optional fallback for Vercel KV state storage)
DATABASE_URL=your_postgres_database_url_here
KV_REST_API_URL=your_vercel_kv_rest_api_url_here
KV_REST_API_TOKEN=your_vercel_kv_rest_api_token_here

# Optional LLM upgrade for reasoning engine (replaces deterministic engine)
OPENAI_API_KEY=your_openai_api_key_here
